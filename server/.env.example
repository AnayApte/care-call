# server/.env for LOCAL development (never commit the real file).
#   cp server/.env.example server/.env
# Fill the empty keys from Railway -> care-call -> Variables -> Raw Editor (the live values).
# Keep the safety switches below as they are when running on your laptop.

# --- safety switches for local runs (Railway uses the live values) ---
PUBLIC_BASE_URL=http://localhost:8000
DEVICE_TOKEN=dev-token
# The live Railway server already runs the Photon bridge; a second bridge would answer every iMessage twice.
ENABLE_PHOTON=false
# true would phone the caregiver from your laptop tests.
ENABLE_PHONE_CALL=false
ENABLE_CREAO=false
# Keeps laptop events out of the live "hackathon" environment in Sentry.
SENTRY_ENVIRONMENT=local
# Leave empty locally so tests never text anyone.
CAREGIVER_PHONE=

# --- timings ---
ESCALATE_MESSAGE_AFTER_S=20
ESCALATE_CALL_AFTER_S=75

# --- keys: copy from Railway ---
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
GEMINI_API_KEY=
SENTRY_DSN=
CREAO_API_KEY=
CREAO_AGENT_ID=
